---
import DocPage from "../../../components/DocPage.astro";
import { configurationSlugFromPath, zhConfigurationAgentDocs } from "../../../configuration-docs";
import { pageKeyFromSlug } from "../../../docs-structure";

export function getStaticPaths() {
  return Object.entries(zhConfigurationAgentDocs).map(([filePath, mod]) => {
    const slug = configurationSlugFromPath(filePath);

    return {
      params: { slug },
      props: {
        mod,
        activeSidebarItem: pageKeyFromSlug("configuration", "zh", slug),
      },
    };
  });
}

const { mod, activeSidebarItem } = Astro.props;
---

<DocPage locale="zh" pageKey="configuration" doc={mod} activeSidebarItem={activeSidebarItem} />
